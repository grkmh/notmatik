[Unit]
Description=Notmatik - Ders Kutuphanesi
After=network.target

[Service]
Type=simple
# Proje yolu ve kullanıcıyı kendine göre değiştir:
WorkingDirectory=/home/KULLANICI/edu
User=KULLANICI
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
