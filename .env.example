# ---- Veritabanı -------------------------------------------------------------
# PostgreSQL bağlantı adresi (Neon, Supabase veya yerel Postgres).
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST:5432/VERITABANI?sslmode=require"

# ---- Auth.js ----------------------------------------------------------------
# Oturum imzası için rastgele ve gizli bir değer. Üretmek için:
#   openssl rand -base64 32
AUTH_SECRET="BURAYA_RASTGELE_BIR_DEGER_YAZ"

# ---- Dosya depolama (Cloudflare R2 / S3 uyumlu) -----------------------------
# R2_ENDPOINT boş bırakılırsa dosyalar geliştirme sırasında .local-storage/
# klasörüne yazılır. Üretimde mutlaka doldurulmalıdır.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="edu-private"

# ---- Yükleme sınırı ---------------------------------------------------------
# Bayt cinsinden. 25 MB = 26214400
MAX_UPLOAD_BYTES=26214400

# ---- Moderasyon -------------------------------------------------------------
# true olduğunda içerikler önce AI incelemesine, sonra yönetici kuyruğuna gider.
AI_REVIEW_ENABLED=false
